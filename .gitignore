simphy/data/

data/*


*.class

*.log

# Runtime diagnostics generated after an unexpected Java/JVM failure.
crash_logs/

backups/

*.zip

# Self-contained release images and archives produced by build_portable.*
dist/

# Local Python environment created by setup_dev.sh
.venv/

# Python bytecode cache directories at any depth
__pycache__/

# Machine-specific backends, built per machine by ./ensure_backends.sh (run.sh
# calls it). A binary built elsewhere generally does not load here (glibc
# symbol versions, -march=native, GPU compute capability), so none are tracked.
native/*.so
native/.build-stamp
native/.build.log
ASTER-Linux/bin/
