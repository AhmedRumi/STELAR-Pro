<mxCell id="139" value="plus rooted clades of the global UPGMA tree." style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#243247;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="80" y="1571" width="730" height="31" as="geometry"/></mxCell>
<mxCell id="140" value="Partial component-root clades are valid candidates." style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#243247;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="80" y="1602" width="730" height="31" as="geometry"/></mxCell>
<mxCell id="141" value="Default S4: no S1 input clades; cross-tree" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#243247;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="80" y="1633" width="730" height="31" as="geometry"/></mxCell>
<mxCell id="142" value="transitions are disabled unless requested." style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#243247;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="80" y="1664" width="730" height="31" as="geometry"/></mxCell>
<mxCell id="144" value="ROOTED STELAR DYNAMIC PROGRAM" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=23;fontStyle=1;fontColor=#FFFFFF;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="960" y="1485" width="780" height="39" as="geometry"/></mxCell>
<mxCell id="145" value="Find the highest triplet-score tree allowed by X." style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#FFFFFF;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="961" y="1541" width="780" height="30" as="geometry"/></mxCell>
<mxCell id="146" value="Weights use original rooted/tagged G1, G2, G3, …" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#FFFFFF;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="961" y="1571" width="780" height="30" as="geometry"/></mxCell>
<mxCell id="147" value="Count only speciation-rooted triplets." style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#FFFFFF;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="961" y="1601" width="780" height="30" as="geometry"/></mxCell>
<mxCell id="148" value="Equivalent triplets at the same gene-tree root" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#FFFFFF;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="961" y="1631" width="780" height="30" as="geometry"/></mxCell>
